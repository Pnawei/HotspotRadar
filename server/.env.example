# 服务端口
PORT=3001

# SQLite 数据库文件路径（相对路径相对于 server/ 目录）
DB_PATH=./data/hotradar.db

# 全站爬取间隔（毫秒），默认 5 分钟
CRAWL_INTERVAL_MS=300000

# 趋势采样保留时长（毫秒），默认 48 小时
TREND_RETENTION_MS=172800000

# DeepSeek（不配置则自动使用规则模板降级）
DEEPSEEK_API_KEY=deepseek官方的api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 单次请求超时（毫秒），默认 30 秒
DEEPSEEK_TIMEOUT_MS=30000

# CORS 白名单（多个来源用逗号分隔；留空则允许全部，仅限本地开发）
# 示例：CORS_ORIGIN=http://localhost:3000,https://hotradar.example.com

# 每轮爬取后最多 AI 扩充的事件数量（控制费用），默认 5
ENRICH_BATCH_SIZE=5
# AI 扩充内容有效期（毫秒），默认 24 小时
ENRICH_TTL_MS=86400000

# 知乎热榜已要求登录态：填入浏览器中的 Cookie 即可恢复采集（可选，留空则该平台离线）
ZHIHU_COOKIE=

# GitHub 个人访问令牌（可选）：填入可提升搜索接口限额
GITHUB_TOKEN=

# 国际平台代理地址：默认尝试本机 Clash Verge；设为 none 可关闭代理
PROXY_URL=http://127.0.0.1:7897
